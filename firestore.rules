rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin or staff
    function isAdminOrStaff() {
      return request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'staff']);
    }

    // Products: anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }
    
    // Orders: anyone can create, owner or admin can read, only admin can update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow read: if request.auth != null && (
        resource.data.customer.email == request.auth.token.email || 
        isAdminOrStaff()
      );
      allow update, delete, list: if isAdminOrStaff();
    }
    
    // Users: owner or admin can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || 
        isAdminOrStaff()
      );
    }
    
    // Invites: admin only, but anyone can verify their own invite code
    match /invites/{email} {
      allow get: if true;
      allow list, write, delete: if isAdminOrStaff();
    }
    
    // CMS Settings: anyone can read, admin only write
    match /cms/{document=**} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Reviews: anyone can read/create, admin only delete
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow delete, update: if isAdminOrStaff();
    }

    // Categories: anyone can read, admin only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Filters: anyone can read, admin only write
    match /filters/{filterId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}