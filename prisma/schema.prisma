datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(uuid())
  name          String
  email         String          @unique
  phone         String?
  password_hash String
  role          String          @default("customer")
  avatar        String?
  skin_type     String?
  created_at    DateTime        @default(now())
  
  addresses     Address[]
  reviews       ProductReview[]
  qnas          ProductQnA[]
  wishlists     Wishlist[]
  carts         Cart[]
  orders        Order[]
  notifications Notification[]
  skin_profiles UserSkinProfile[]

  @@map("users")
}

model UserSkinProfile {
  id            String   @id @default(uuid())
  user_id       String
  skin_type     String
  concern       String
  routine_type  String
  budget        String
  answers_json  String
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_skin_profiles")
}

model Address {
  id           String   @id @default(uuid())
  user_id      String
  label        String
  address_line String
  city         String
  zip          String?
  is_default   Boolean  @default(false)
  
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([user_id])
  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  parent_id   String?
  image       String?
  description String?
  is_active   Boolean    @default(true)
  
  parent      Category?  @relation("CategoryToCategory", fields: [parent_id], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logo        String?
  description String?
  
  products    Product[]

  @@map("brands")
}

model Product {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  brand_id         String?
  category_id      String?
  description      String?
  ingredients      String?
  how_to_use       String?
  skin_type_tags   String[]
  price            Decimal          @db.Decimal(10, 2)
  discount_price   Decimal?         @db.Decimal(10, 2)
  sku              String           @unique
  stock_qty        Int              @default(0)
  is_featured      Boolean          @default(false)
  is_active        Boolean          @default(true)
  is_free_delivery Boolean          @default(false)
  meta_title       String?
  meta_description String?
  
  brand            Brand?           @relation(fields: [brand_id], references: [id])
  category         Category?        @relation(fields: [category_id], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  reviews          ProductReview[]
  qnas             ProductQnA[]
  wishlists        Wishlist[]

  @@index([brand_id])
  @@index([category_id])
  @@index([is_featured, is_active])
  @@map("products")
}

model ProductVariant {
  id          String      @id @default(uuid())
  product_id  String
  size        String?
  color       String?
  sku         String      @unique
  price       Decimal?    @db.Decimal(10, 2)
  stock_qty   Int         @default(0)
  image       String?
  
  product     Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart_items  CartItem[]
  order_items OrderItem[]

  @@index([product_id])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid())
  product_id String
  url        String
  alt_text   String?
  position   Int      @default(0)
  
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_images")
}

model ProductReview {
  id                String   @id @default(uuid())
  product_id        String
  user_id           String
  rating            Int
  title             String?
  comment           String?
  images            String[]
  verified_purchase Boolean  @default(false)
  helpful_count     Int      @default(0)
  status            String   @default("Pending")
  reply             String?
  created_at        DateTime @default(now())
  
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([user_id])
  @@index([status])
  @@map("product_reviews")
}

model ProductQnA {
  id          String   @id @default(uuid())
  product_id  String
  user_id     String
  question    String
  answer      String?
  answered_by String?
  created_at  DateTime @default(now())
  
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([user_id])
  @@map("product_qna")
}

model Wishlist {
  id         String  @id @default(uuid())
  user_id    String
  product_id String
  
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([user_id, product_id])
  @@map("wishlists")
}

model Cart {
  id         String     @id @default(uuid())
  user_id    String?
  session_id String     @unique
  
  user       User?      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@index([user_id])
  @@map("carts")
}

model CartItem {
  id                 String         @id @default(uuid())
  cart_id            String
  product_variant_id String
  quantity           Int            @default(1)
  
  cart               Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)

  @@index([cart_id])
  @@index([product_variant_id])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(uuid())
  user_id        String?
  order_number   String      @unique
  status         String      @default("pending")
  subtotal       Decimal     @db.Decimal(10, 2)
  discount       Decimal     @db.Decimal(10, 2) @default(0)
  shipping_fee   Decimal     @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  payment_method String
  payment_status String      @default("pending")
  address_id     String
  created_at     DateTime    @default(now())
  
  customer_notes String?     @default("")
  admin_notes    String?     @default("")
  courier        String?     @default("")
  thana          String?     @default("")
  area           String?     @default("")
  assigned_to    String?     @default("")
  status_history OrderStatusHistory[]
  
  user           User?       @relation(fields: [user_id], references: [id], onDelete: SetNull)
  address        Address     @relation(fields: [address_id], references: [id], onDelete: Restrict)
  items          OrderItem[]

  @@index([user_id])
  @@index([address_id])
  @@index([status])
  @@index([assigned_to])
  @@map("orders")
}

model OrderItem {
  id                 String         @id @default(uuid())
  order_id           String
  product_variant_id String
  quantity           Int
  price_at_purchase  Decimal        @db.Decimal(10, 2)
  
  order              Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_variant_id])
  @@map("order_items")
}

model Coupon {
  id               String   @id @default(uuid())
  code             String   @unique
  type             String
  value            Decimal  @db.Decimal(10, 2)
  min_order_amount Decimal  @db.Decimal(10, 2) @default(0)
  usage_limit      Int?
  expiry_date      DateTime

  @@map("coupons")
}

model Banner {
  id         String    @id @default(uuid())
  title      String?
  image      String
  link       String?
  position   String?
  is_active  Boolean   @default(true)
  start_date DateTime?
  end_date   DateTime?

  @@map("banners")
}

model BlogPost {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  content      String
  summary      String?
  cover_image  String?
  author       String?
  tags         String[]
  is_published Boolean   @default(false)
  created_at   DateTime  @default(now())

  @@map("blog_posts")
}

model HomepageSection {
  id           String  @id @default(uuid())
  section_type String
  title        String?
  config_json  String
  position     Int     @default(0)
  is_active    Boolean @default(true)

  @@map("homepage_sections")
}

model AdminUser {
  id              String  @id @default(uuid())
  name            String
  email           String  @unique
  role            String  @default("admin")
  permissions_json String?

  @@map("admin_users")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String?
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  order_id   String
  status     String
  note       String?
  created_at DateTime @default(now())

  order      Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

model Moderator {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  status       String   @default("Active") // "Active" | "Inactive"
  permissions  String[]
  created_at   DateTime @default(now())

  @@map("moderators")
}

model Invitation {
  id           String   @id @default(uuid())
  email        String   @unique
  token        String
  permissions  String[]
  created_at   DateTime @default(now())

  @@map("invitations")
}

model AuditLog {
  id              String   @id @default(uuid())
  moderator_email String
  moderator_name  String
  action          String
  details         String
  timestamp       DateTime @default(now())

  @@index([moderator_email])
  @@index([timestamp])
  @@map("audit_logs")
}
